NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Supabase Auth sessions (login/signup). Safe to expose — it is the public
# "anon"/publishable key from Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

AWS_REGION=eu-central-1
AWS_S3_BUCKET=your-private-invoice-bucket
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

OPENAI_API_KEY=your-openai-key
AI_MODEL=gpt-4.1-mini

# Put this same value in n8n HTTP Request headers as x-api-key.
# Leave empty only for local testing.
API_INTERNAL_KEY=change-me-in-production

# Rollback switch for the Basic Auth cutover. Unset (the default) = Supabase
# Auth sessions. Set to 1 to restore the old HTTP Basic Auth popup instead —
# the two cannot run at the same time. Delete this and DASHBOARD_USER/PASS once
# session auth is confirmed in production.
# LEGACY_BASIC_AUTH=1
# DASHBOARD_USER=admin
# DASHBOARD_PASS=
